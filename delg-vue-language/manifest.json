{
  "schemaVersion": 2,
  "id": "delg.vue-language",
  "publisherId": "6adaebe83d78d03786e99a1c",
  "publisher": {
    "displayName": "DELG",
    "description": "Official DELG Plugins"
  },
  "name": "DELG Vue Language",
  "description": "Optional Vue, TypeScript, and JavaScript intelligence with cross-file Vue and TypeScript navigation and rename.",
  "version": "0.2.0",
  "entry": "plugin.js",
  "engines": {
    "delgIde": ">=0.36.0"
  },
  "capabilities": [
    "commands",
    "language-servers",
    "status",
    "status-bar",
    "trusted-ui"
  ],
  "contributes": {
    "commands": [
      {
        "command": "delg.vue-language.restart",
        "title": "Vue: Restart Language Server"
      },
      {
        "command": "delg.vue-language.setupHelp",
        "title": "Vue: Show Setup Help"
      },
      {
        "command": "delg.vue-language.showStatus",
        "title": "Vue: Language Server Status"
      }
    ],
    "languageServers": [
      {
        "id": "delg.vue-language.vue-typescript-language-server",
        "languages": [
          "vue",
          "typescript",
          "javascript",
          "typescriptreact",
          "javascriptreact"
        ],
        "command": "",
        "entrypoint": "servers/vue-language-server.mjs",
        "args": [
          "--stdio"
        ],
        "projectMarkers": [
          "package.json",
          "tsconfig.json",
          "jsconfig.json",
          "vite.config.ts",
          "vue.config.js"
        ],
        "configuration": {
          "plugins": [
            "@vue/typescript-plugin"
          ]
        }
      }
    ]
  },
  "source": {
    "repository": "https://github.com/DELG-Software/DELG-Code-IDE-Plugins",
    "commit": "332856311c3e57d1c69f6c7ff0001a425a3abf8a"
  }
}
