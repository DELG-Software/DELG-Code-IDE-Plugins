{
  "schemaVersion": 2,
  "id": "delg.go-language",
  "publisherId": "6adaebe83d78d03786e99a1c",
  "publisher": {
    "displayName": "DELG",
    "description": "Official DELG Plugins"
  },
  "name": "DELG Go Language",
  "description": "Optional Go completion, navigation, diagnostics, formatting through gopls, and debugging through Delve.",
  "version": "0.3.0",
  "entry": "plugin.js",
  "engines": {
    "delgIde": ">=0.39.0"
  },
  "activationEvents": [
    "onLanguage:go",
    "workspaceContains:go.mod",
    "workspaceContains:go.work"
  ],
  "capabilities": [
    "commands",
    "debugging",
    "language-servers",
    "status",
    "status-bar",
    "trusted-ui"
  ],
  "contributes": {
    "commands": [
      {
        "command": "delg.go-language.restart",
        "title": "Go: Restart Language Server"
      },
      {
        "command": "delg.go-language.setupHelp",
        "title": "Go: Show Setup Help"
      },
      {
        "command": "delg.go-language.showStatus",
        "title": "Go: Language Server Status"
      }
    ],
    "configuration": [
      {
        "key": "delg.go-language.staticcheck",
        "type": "boolean",
        "default": true,
        "description": "Run staticcheck's extra analyses in the editor.",
        "scope": "global"
      },
      {
        "key": "delg.go-language.buildTags",
        "type": "string",
        "default": "",
        "description": "Build tags for gopls, separated by commas (for example: integration,linux).",
        "scope": "global"
      }
    ],
    "languageServers": [
      {
        "id": "delg.go-language.gopls",
        "languages": [
          "go"
        ],
        "command": "gopls",
        "args": [
          "serve"
        ],
        "projectMarkers": [
          "go.mod",
          "go.work"
        ],
        "configuration": {
          "analyses": {
            "unusedparams": true
          },
          "staticcheck": true
        }
      }
    ]
  },
  "source": {
    "repository": "https://github.com/DELG-Software/DELG-Code-IDE-Plugins",
    "commit": "c71380066327a1c28c7a58461c8a88c82d19eb14"
  }
}
